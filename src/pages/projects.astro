---
import Footer from "@/components/layout/Footer.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import { ogUrl } from "@/config/site";
import { projects as projectsData } from "@/data/projects";
import Layout from "@/layouts/Layout.astro";
import BrandIcon from "../components/brand/BrandIcon.astro";

const ogDescription =
	"Projects and work by Juan Manuel Cerón: Optima B2B SaaS, high-throughput backend systems at Disney & Mercado Libre, and more.";
const ogImage = ogUrl({
	title: "Projects",
	description: ogDescription,
	tag: "projects",
});

const projectsWithStars = projectsData.map((p) => ({ ...p, stars: 0 }));
const projects = projectsWithStars
	.map((project) => ({
		...project,
		github: project.repo ? `https://github.com/${project.repo}` : undefined,
	}));

---

<Layout title="Projects – Juan Manuel Cerón" description={ogDescription} image={ogImage}>
	<PageLayout class="flex flex-col gap-8">
		<header class="space-y-3">
			<SectionHeader title="Projects" />
			<p class="max-w-2xl text-base leading-relaxed text-foreground-2">
				A curated collection of production platforms, distributed consensus engines, and applied AI systems I've designed and built.
			</p>
		</header>

		<section class="space-y-4">
			{projects.map((project) => (
				<article class="p-5 rounded-lg border border-ui/40 bg-background-2/40 hover:border-ui/80 hover:bg-background-2 transition-all duration-200 flex flex-col gap-3">
					<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
						<div class="flex items-center gap-2.5">
							<span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-background border border-ui/50 text-foreground">
								<BrandIcon name={project.icon} width={16} height={16} />
							</span>
							<h2 class="text-base font-medium text-foreground tracking-tight">
								<a
									href={project.url}
									target="_blank"
									rel="noopener noreferrer"
									class="hover:underline"
								>
									{project.name}
								</a>
							</h2>
						</div>

						<div class="flex items-center gap-2 shrink-0">
							{project.github && (
								<a
									href={project.github}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-ui/60 bg-background text-xs font-mono text-foreground-2 hover:text-foreground hover:border-ui transition-colors"
									title="View Source Code"
								>
									<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
										<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
									</svg>
									<span>Code</span>
								</a>
							)}
							<a
								href={project.url}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md border border-ui/60 bg-background text-xs font-mono text-foreground-2 hover:text-foreground hover:border-ui transition-colors"
								title="Visit"
							>
								<span>Visit</span>
								<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M7 17L17 7" />
									<polyline points="7 7 17 7 17 17" />
								</svg>
							</a>
						</div>
					</div>

					<p class="text-sm leading-relaxed text-foreground-2">
						{project.longDescription ?? project.description}
					</p>

					{project.tags && project.tags.length > 0 && (
						<div class="flex flex-wrap gap-1.5 pt-1">
							{project.tags.map((tag) => (
								<span class="rounded bg-ui/60 px-2 py-0.5 font-mono text-[11px] text-foreground-3">
									{tag}
								</span>
							))}
						</div>
					)}
				</article>
			))}
		</section>

		<Footer />
	</PageLayout>
</Layout>
