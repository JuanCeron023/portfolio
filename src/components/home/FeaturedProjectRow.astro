---
import BrandIcon from "../brand/BrandIcon.astro";
import type { BrandName } from "../brand/registry";

interface Props {
	project: {
		name: string;
		description: string;
		url: string;
		icon: BrandName;
		stars: number;
		repo?: string;
	};
	maxStars: number;
}

const { project } = Astro.props;

---

<a
	href={project.url}
	target="_blank"
	rel="noopener noreferrer"
	class="group -mx-3 flex items-center gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-background-2"
>
	<span class="flex size-5 shrink-0 items-center justify-center">
		<BrandIcon name={project.icon} width={18} height={18} class="text-foreground" />
	</span>

	<span class="w-36 shrink-0 truncate text-sm font-medium text-foreground sm:w-40">
		{project.name}
	</span>

	<span class="hidden min-w-0 flex-1 truncate text-sm text-foreground-3 md:block">
		{project.description}
	</span>

	<!-- External arrow -->
	<span class="flex shrink-0 items-center justify-end text-foreground-3 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-foreground">
		<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M7 17L17 7"/>
			<polyline points="7 7 17 7 17 17"/>
		</svg>
	</span>
</a>
